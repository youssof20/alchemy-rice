{
  "format_version": 1,
  "panels": [
    {
      "logical_id": "main",
      "location": "bottom",
      "alignment": "center",
      "floating": true,
      "height": {
        "unit": "screen_percent",
        "value": 4.0,
        "min_px": 32,
        "max_px": 64
      },
      "screen_role": "primary",
      "length_mode": "fill",
      "hiding": "none",
      "opacity": "adaptive",
      "widgets": [
        {
          "plugin": "org.kde.plasma.kickoff",
          "slot": "left"
        },
        {
          "plugin": "org.kde.plasma.icontasks",
          "slot": "center"
        },
        {
          "plugin": "org.kde.plasma.digitalclock",
          "slot": "right"
        }
      ]
    }
  ]
}
